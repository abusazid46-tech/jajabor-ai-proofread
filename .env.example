# Jajabor AI Proofread Environment Configuration
# NOTE: No API keys are required for core deterministic proofreading demonstration.

# Backend Settings
PROJECT_NAME="Jajabor AI Proofread"
DATABASE_URL="sqlite:///./jajabor.db"
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"
MAX_FILE_SIZE_BYTES=15728640

# Optional AI Provider Configuration
# Set to 'none' for deterministic offline mode (default)
# Set to 'gemini' and supply AI_API_KEY for optional contextual suggestions
AI_PROVIDER="none"
AI_API_KEY=""
AI_TIMEOUT_SECONDS=15
AI_MAX_CHARS_PER_REQUEST=4000

# Frontend Settings
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
